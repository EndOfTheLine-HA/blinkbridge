# Keep the default loopback bind unless RTSP clients run on another host.
# If you expose RTSP on a LAN interface, add MediaMTX authentication and
# firewall rules appropriate to that network.
BLINKBRIDGE_RTSP_BIND=127.0.0.1

# Optional alternatives to storing the initial Blink login in config.json.
# BLINK_USERNAME=person@example.invalid
# BLINK_PASSWORD=replace-me
